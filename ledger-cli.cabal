cabal-version:      2.4
name:               ledger-cli
version:            0.1.0.0
synopsis:           Personal finance tracker: CSV import, categorization, net worth reporting
build-type:         Simple

common warnings
    ghc-options: -Wall -Wcompat
                 -Wincomplete-record-updates -Wincomplete-uni-patterns
                 -Wredundant-constraints

library
    import:           warnings
    hs-source-dirs:   src
    exposed-modules:  Domain.Types
                      Domain.Validation
                      Import.CSV
                      Import.Dedup
                      Import.Run
                      Categorize.Rules
                      Categorize.Review
                      Categorize.Prompt
                      Persistence.DB
                      Report.NetWorth
                      Report.Spending
                      Server.API
                      Server.Demo
    build-depends:    base >=4.17 && <5
                    , text
                    , time
                    , bytestring
                    , containers
                    , cassava
                    , sqlite-simple
                    , cryptohash-sha256
                    , base16-bytestring
                    , vector
                    , aeson
                    , servant
                    , servant-server
                    , wai
                    , wai-app-static
                    , warp
    default-language: Haskell2010

executable ledger
    import:           warnings
    hs-source-dirs:   app
    main-is:          Main.hs
    -- warp needs the threaded runtime for its timer manager.
    ghc-options:      -threaded -rtsopts
    build-depends:    base, ledger-cli, text, time, optparse-applicative, bytestring
    default-language: Haskell2010

test-suite spec
    import:           warnings
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Spec.hs
    other-modules:    Domain.TypesSpec
                      Domain.ValidationSpec
                      Import.CSVSpec
                      Import.DedupSpec
                      Categorize.RulesSpec
                      Categorize.ReviewSpec
                      Persistence.DBSpec
                      Report.SpendingSpec
                      Gen
    build-depends:    base, ledger-cli, text, time, bytestring, containers
                    , QuickCheck, tasty, tasty-quickcheck, tasty-hunit
                    , sqlite-simple, temporary, directory, filepath
    default-language: Haskell2010
